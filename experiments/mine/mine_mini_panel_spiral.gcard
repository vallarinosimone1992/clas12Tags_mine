<gcard>
    <option name="HIT_PROCESS_LIST" value="mine"/>
    <detector name="experiments/mine/mine" factory="TEXT" variation="mini_panel_spiral"/>

    <!-- Generic GEMC world half-lengths; no external geometry or fields. -->
    <option name="HALL_DIMENSIONS" value="1000*mm, 1000*mm, 1000*mm"/>
    <option name="HALL_MATERIAL" value="G4_AIR"/>
    <option name="HALL_FIELD" value="no"/>
    <option name="FIELD_DIR" value="."/>
    <option name="RFSETUP" value="no"/>

    <!-- A 10 GeV/c muon, uniform XY over the 300x500-mm panel, travels along +Z. -->
    <option name="BEAM_P" value="mu-, 10*GeV, 0*deg, 0*deg"/>
    <option name="BEAM_V" value="(0, 0, -100)mm"/>
    <option name="SPREAD_P" value="0*GeV, 0*deg, 0*deg"/>
    <option name="SPREAD_V" value="(150, 250, 0)mm"/>

    <option name="PHYSICS" value="STD + FTFP_BERT"/>
    <option name="USE_GUI" value="0"/>
    <option name="N" value="1"/>

    <!-- INTEGRATEDDGT names systems whose digitization is DISABLED. -->
    <option name="INTEGRATEDDGT" value="yes"/>
    <option name="INTEGRATEDRAW" value="mine"/>
    <option name="OUTPUT" value="hipo, experiments/mine/output/mine.hipo"/>
</gcard>

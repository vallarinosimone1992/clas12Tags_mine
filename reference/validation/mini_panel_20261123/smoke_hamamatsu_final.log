# Optional Hamamatsu PDE/finite-cell/noise response; timing jitter remains zero.
# Geometry source: MC_MINE_LightTrapping/config/mini_panel_spiral.conf.
# EJ200 nominal yield/decay/rise/density; 1000-mm bulk absorption is provisional.
# Active spectral Kuraray budget, Mylar wrapping, G608N3 gel in groove and sensor gap.
geometry=mini_panel_spiral
sipmModel=hamamatsu
sensorGelGapMm=1
tentAngleDeg=30
tentClearanceMm=0
miniCurveToleranceMm=0.0002
model=spectral_wls
wlsDyeConcentrationPpm=200
wlsEmissionConvention=photon_per_nm
fiberModel=Y-11
sensorCount=2
fiberCount=2
diagonal=bl_tr
pitchMm=100
minBendRadiusMm=30
fiberDiameterMm=1
claddingFraction=0.03
zMcMm=6.5
# Measured top groove: 1x2 mm, centers z_MC=6.5/7.5 mm before the external S.
# Choices: gel (Thorlabs G608N3), air, glue (Eljen EJ-500); see reference/grooves.md.
grooveModel=rectangular
grooveWidthMm=1
grooveDepthMm=2
grooveMaterial=gel
readoutInsetMm=10
readoutWidthMm=3
readoutHeightMm=3
autoFit=1
checkOverlaps=1
nScintillator=1.58
nCore=1.59
nCladding=1.49
# Aluminized Mylar 10 um: Yang et al. 2021 Fig.3(a), R(lambda) relative to BaSO4.
# Unity reference albedo is an explicit approximation, not an absolute calibration.
# For other materials use coatingMaterial=fnal_tio2|tyvek and coatingModel=diffuse.
coatingModel=specular
coatingMaterial=aluminized_mylar
coatingReferenceAlbedo=1
# Scalar reflectivity is permitted only with coatingMaterial=constant.
birksMmPerMeV=0.126
lightYieldPerMeV=10000
scintillationDecayNs=2.1
scintillationRiseNs=0.9
scintillatorDensityGcm3=1.023
# Generation spectrum: monochromatic | fnal_extruded | ej200.
# The last two require model=spectral_wls; sources/limits: data/optics/scintillators/README.md.
# EJ200 emission spectrum; attenuation remains an explicit provisional path length.
# Change only the spectrum here; yield, time constants and absorption above/below stay explicit.
scintillationSpectrum=ej200
scintillationEmissionConvention=photon_per_nm
# Used only for monochromatic scintillation (legacy configuration fallback).
scintillationWavelengthNm=425
# wlsWavelengthNm is a nominal legacy proxy; spectral emission uses the dataset.
wlsWavelengthNm=476
wlsDecayNs=6.9
wlsQuantumYield=1
# wlsAbsorptionLengthMm is used only by monochromatic_effective.
# Intensity survival exp(-actual optical ray distance / length). Zero disables.
bulkAbsorptionLengthMm=1000
coreAbsorptionLengthMm=0
claddingAbsorptionLengthMm=0
# Kuraray spectral budget: same ordinary curve in core/cladding, WLS counted once.
# Y11 uses mean YS4/YS6 coefficients; see reference/wls_spectral_loss.md.
effectiveFiberAttenuationMm=0
fiberLossModel=kuraray_spectral
